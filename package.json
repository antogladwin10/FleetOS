{
  "name": "fleet-os",
  "version": "1.0.0",
  "description": "Human-Centered Fleet Operations, Tracking & Profitability Platform",
  "scripts": {
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "backend:dev": "npm run dev --prefix backend",
    "frontend:dev": "npm run dev --prefix frontend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "seed": "npm run seed --prefix backend",
    "test": "npm test --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": ["fleet-management", "saas", "multi-tenant", "telemetry", "tracking", "profitability", "payroll"],
  "author": "FleetOS Team",
  "license": "ISC"
}
